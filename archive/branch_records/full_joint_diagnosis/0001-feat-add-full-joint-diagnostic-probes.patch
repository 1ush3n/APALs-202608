+    def diagnose_action_logprobs(
+        self,
+        obs: HeteroData,
+        action: Tuple[int, int, List[int]],
+        mask_task: Optional[torch.Tensor] = None,
+        mask_station_matrix: Optional[torch.Tensor] = None,
+        mask_worker: Optional[torch.Tensor] = None,
+        *,
+        temperature: float = 1.0,
+        is_eval: bool = True,
+    ) -> Dict[str, Any]:
+        """在不采样、不更新参数的条件下重算 Full legacy 动作概率。
+
+        该入口只服务于初始 Full 的 rollout/replay identity 诊断；它不改变
+        正式 PPO 更新路径。WorkerPointer v2 使用已有的 behavior replay 入口，
+        不在这里增加第二套 v2 语义。
+        """
+        action_scope = str(
+            getattr(self.config, "policy_action_scope", "operation_station_worker")
+        )
+        if action_scope != "operation_station_worker":
+            raise ValueError(
+                "动作概率诊断仅支持 Full 的 operation_station_worker 口径"
+            )
+        if is_worker_pointer_v2_mode(self.config):
+            raise ValueError(
+                "动作概率诊断的 legacy 入口不接受 WorkerPointer v2；"
+                "请使用现有 v2 behavior replay"
+            )
+        task_id, station_id, team = action
+        task_id = int(task_id)
+        station_id = int(station_id)
+        team = [int(worker_id) for worker_id in team]
+        active_policy = (
+            self.ema_policy
+            if is_eval and getattr(self, "use_ema", False) and hasattr(self, "ema_policy")
+            else self.policy
+        )
+
+        with torch.inference_mode():
+            with self.autocast_context():
+                x_dict, global_context = active_policy(obs)
+
+            with self.autocast_context():
+                task_logits = active_policy.task_head(
+                    x_dict["task"], global_context, mask=None
+                )
+            if temperature != 1.0:
+                task_logits = task_logits / max(float(temperature), 1.0e-5)
+            task_invalid = (
+                mask_task.to(self.device).reshape(task_logits.shape)
+                if mask_task is not None
+                else torch.zeros_like(task_logits, dtype=torch.bool)
+            )
+            task_logits, task_usable = _finalize_action_logits(
+                task_logits, task_invalid, decision="diagnostic.task"
+            )
+            if not bool(task_usable.all()) or bool(task_invalid.reshape(-1)[task_id]):
+                raise ValueError(f"诊断动作的 task 非法或动作空间为空: {task_id}")
+            task_target = torch.tensor(
+                task_id, device=self.device, dtype=torch.long
+            ).reshape(task_logits.shape[:-1])
+            task_dist = Categorical(logits=task_logits)
+            task_logprob = task_dist.log_prob(task_target)
+            task_entropy = task_dist.entropy()
+
+            task_features = obs["task"].x
+            worker_layout = resolve_worker_feature_layout(self.config)
+            task_skill_end = 5 + int(worker_layout.num_skill_types)
+            is_virtual_task = not bool(
+                (task_features[task_id, 5:task_skill_end] > 0.5).any()
+            )
+            if is_virtual_task:
+                if station_id != -1 or team:
+                    raise ValueError("虚拟任务的诊断动作必须使用 station=-1、空团队")
+                return {
+                    "task": float(task_logprob.item()),
+                    "station": 0.0,
+                    "worker": 0.0,
+                    "total": float(task_logprob.item()),
+                    "task_entropy": float(task_entropy.mean().item()),
+                    "station_entropy": 0.0,
+                    "worker_logprobs": [],
+                    "worker_entropy": [],
+                    "worker_max_probability": [],
+                    "legal_worker_count": [],
+                    "team_size": 0,
+                }
+
+            if mask_station_matrix is None:
+                station_invalid = torch.zeros(
+                    (1, x_dict["station"].size(0)),
+                    dtype=torch.bool,
+                    device=self.device,
+                )
+            else:
+                station_invalid = mask_station_matrix[task_id].to(self.device).reshape(1, -1)
+            if station_id < 0 or station_id >= x_dict["station"].size(0):
+                raise ValueError(f"诊断动作的 station 越界: {station_id}")
+            with self.autocast_context():
+                station_logits = active_policy.station_head(
+                    x_dict["task"][task_id].unsqueeze(0),
+                    x_dict["station"].unsqueeze(0),
+                    mask=None,
+                )
+            if temperature != 1.0:
+                station_logits = station_logits / max(float(temperature), 1.0e-5)
+            station_logits, station_usable = _finalize_action_logits(
+                station_logits, station_invalid, decision="diagnostic.station"
+            )
+            if not bool(station_usable.all()) or bool(station_invalid[0, station_id]):
+                raise ValueError(f"诊断动作的 station 非法或动作空间为空: {station_id}")
+            station_dist = Categorical(logits=station_logits)
+            station_logprob = station_dist.log_prob(
+                torch.tensor([station_id], device=self.device, dtype=torch.long)
+            )
+            station_entropy = station_dist.entropy()
+
+            worker_features = obs["worker"].x
+            if worker_features.size(1) != worker_layout.total_dim:
+                raise ValueError(
+                    f"工人特征维度错误: {worker_features.size(1)} != {worker_layout.total_dim}"
+                )
+            worker_skills = worker_features[:, worker_layout.skill_slice]
+            task_type_idx = int(
+                torch.argmax(task_features[task_id, 5:task_skill_end]).item()
+            )
+            current_worker_mask = (
+                mask_worker.to(self.device).clone()
+                if mask_worker is not None
+                else torch.zeros(
+                    worker_features.size(0), dtype=torch.bool, device=self.device
+                )
+            )
+            has_skill = worker_skills[:, task_type_idx] > 0.5
+            worker_locks = torch.argmax(
+                worker_features[:, worker_layout.lock_slice], dim=1
+            )
+            current_worker_mask |= ~has_skill
+            current_worker_mask |= (worker_locks != 0) & (worker_locks != station_id + 1)
+            demand = int(self.get_task_demand(task_features, task_id))
+            if len(team) != demand:
+                raise ValueError(
+                    f"诊断动作团队人数与需求不一致: team={len(team)}, demand={demand}"
+                )
+
+            worker_embeddings = x_dict["worker"].unsqueeze(0)
+            current_team_emb = None
+            worker_logprobs: list[float] = []
+            worker_entropies: list[float] = []
+            worker_max_probabilities: list[float] = []
+            legal_worker_counts: list[int] = []
+            for step, worker_id in enumerate(team, start=1):
+                if worker_id < 0 or worker_id >= worker_features.size(0):
+                    raise ValueError(f"诊断动作的 worker 越界: {worker_id}")
+                if bool(current_worker_mask[worker_id]):
+                    raise ValueError(
+                        f"诊断动作的 worker 在第 {step} 步被 mask: {worker_id}"
+                    )
+                with self.autocast_context():
+                    worker_logits = active_policy.worker_head.forward_choice(
+                        x_dict["task"][task_id].unsqueeze(0),
+                        worker_embeddings,
+                        mask=None,
+                        current_team_emb=current_team_emb,
+                    )
+                if temperature != 1.0:
+                    worker_logits = worker_logits / max(float(temperature), 1.0e-5)
+                worker_invalid = current_worker_mask.reshape(worker_logits.shape)
+                worker_logits, worker_usable = _finalize_action_logits(
+                    worker_logits,
+                    worker_invalid,
+                    decision=f"diagnostic.worker[step={step}]",
+                )
+                if not bool(worker_usable.all()):
+                    raise ValueError(f"诊断动作第 {step} 步 worker 动作空间为空")
+                worker_dist = Categorical(logits=worker_logits)
+                worker_target = torch.tensor(
+                    [worker_id], device=self.device, dtype=torch.long
+                )
+                worker_logprobs.append(float(worker_dist.log_prob(worker_target).item()))
+                worker_entropies.append(float(worker_dist.entropy().item()))
+                legal_probabilities = worker_dist.probs.masked_fill(
+                    worker_invalid, 0.0
+                )
+                worker_max_probabilities.append(
+                    float(legal_probabilities.max().item())
+                )
+                legal_worker_counts.append(int((~current_worker_mask).sum().item()))
+                selected_embeddings = worker_embeddings[0, team[:step], :]
+                current_team_emb = selected_embeddings.mean(dim=0, keepdim=True)
+                current_worker_mask = current_worker_mask.clone()
+                current_worker_mask[worker_id] = True
+
+            worker_logprob = sum(worker_logprobs)
+            return {
+                "task": float(task_logprob.item()),
+                "station": float(station_logprob.item()),
+                "worker": float(worker_logprob),
+                "total": float(task_logprob.item() + station_logprob.item() + worker_logprob),
+                "task_entropy": float(task_entropy.mean().item()),
+                "station_entropy": float(station_entropy.mean().item()),
+                "worker_logprobs": worker_logprobs,
+                "worker_entropy": worker_entropies,
+                "worker_max_probability": worker_max_probabilities,
+                "legal_worker_count": legal_worker_counts,
+                "team_size": len(team),
+            }
+
