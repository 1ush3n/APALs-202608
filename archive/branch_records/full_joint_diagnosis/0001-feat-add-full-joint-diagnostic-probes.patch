+def _scenario_specs(names: Iterable[str] | None) -> list[dict[str, Any]]:
+    scenarios = [
+        {"name": "standard", "rand_dur": False, "rand_w": False, "dyn_ev": False},
+        {"name": "duration_noise", "rand_dur": True, "rand_w": False, "dyn_ev": False},
+        {"name": "worker_noise", "rand_dur": False, "rand_w": True, "dyn_ev": False},
+        {"name": "dynamic_events", "rand_dur": False, "rand_w": False, "dyn_ev": True},
+    ]
+    if names is None:
+        return scenarios
+    selected = {str(name).strip().lower() for name in names if str(name).strip()}
+    unknown = selected - {item["name"] for item in scenarios}
+    if unknown:
+        raise ValueError(f"未知初始调度场景: {sorted(unknown)}")
+    return [item for item in scenarios if item["name"] in selected]
+
