+
+def test_action_comparison_preserves_autoregressive_worker_order() -> None:
+    action = (3, 2, [5, 1])
+
+    assert canonicalize_action(action) == (3, 2, (5, 1))
+    assert compare_actions(action, (3, 2, [5, 1]))
+    assert not compare_actions(action, (3, 2, [1, 5]))
+    assert canonicalize_action((7, 4, [9]), virtual_task=True) == (7, -1, ())
+
+
+def test_numeric_summary_reports_nonfinite_values_and_direction() -> None:
+    summary = summarize_numeric([1.0, 2.0, 3.0, float("nan"), float("inf")])
+
+    assert summary["latest"] == 3.0
+    assert summary["mean"] == 2.0
+    assert summary["minimum"] == 1.0
+    assert summary["maximum"] == 3.0
+    assert summary["nan_count"] == 1
+    assert summary["inf_count"] == 1
+    assert summary["trend"] == "rising"
+
+
+def test_team_size_grouping_and_logprob_error_summary() -> None:
+    assert [team_size_bucket(k) for k in (1, 2, 3, 4, 5, 9)] == [
+        "1",
+        "2",
+        "3",
+        "4",
+        "5+",
+        "5+",
+    ]
+    grouped = summarize_by_team_size(
+        [
+            {"team_size": 1, "joint_clip": 0.1},
+            {"team_size": 5, "joint_clip": 0.5},
+        ],
+        value_keys=("joint_clip",),
+    )
+    assert grouped["1"]["count"] == 1
+    assert grouped["5+"]["joint_clip"]["mean"] == 0.5
+
+    errors = logprob_error_summary(
+        [
+            {"task": 1.0e-6, "station": 2.0e-6, "worker": 4.0e-6, "total": 3.0e-6},
+            {"task": 2.0e-6, "station": 1.0e-6, "worker": 5.0e-6, "total": 4.0e-6},
+        ]
+    )
+    assert errors["max_total_error"] == 4.0e-6
+    assert errors["max_worker_error"] == 5.0e-6
+    assert errors["passed_fp32"]
+
+
+def test_protocol_invariants_are_explicit() -> None:
+    metadata = {
+        "policy_action_scope": "operation_station_worker",
+        "policy_observation_scope": "full",
+        "team_selection_mode": "autoregressive",
+        "num_skill_types": 5,
+    }
+
+    assert validate_protocol_invariants(metadata, metadata) == []
+    errors = validate_protocol_invariants(
+        {**metadata, "team_selection_mode": "static_topq"}, metadata
+    )
+    assert errors == ["team_selection_mode: actual='static_topq', expected='autoregressive'"]
