+def _set_scenario(config_obj: Any, scenario: Mapping[str, Any]) -> dict[str, Any]:
+    keys = (
+        "enable_dynamic_events",
+        "enable_station_breakdown",
+        "enable_material_delay",
+    )
+    backup = {key: getattr(config_obj, key, False) for key in keys}
+    config_obj.enable_dynamic_events = bool(scenario["dyn_ev"])
+    config_obj.enable_station_breakdown = bool(scenario["dyn_ev"])
+    config_obj.enable_material_delay = bool(scenario["dyn_ev"])
+    return backup
+
