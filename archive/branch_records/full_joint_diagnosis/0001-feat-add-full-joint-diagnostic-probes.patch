+def _protocol_data_audit(data_path: Path, seed: int) -> dict[str, Any]:
+    env = AirLineEnv_Graph(data_path_or_dir=str(data_path), seed=int(seed))
+    task_x = env.base_task_x.detach().cpu()
+    worker_x = env.base_worker_x.detach().cpu()
+    layout = resolve_worker_feature_layout(configs)
+    skill_slice = layout.skill_slice
+    task_skills = task_x[:, 5 : 5 + layout.num_skill_types]
+    physical = task_x[:, 0] > 1.0e-8
+    skill_present = task_skills[:, : layout.num_skill_types] > 0.5
+    worker_skills = worker_x[:, skill_slice] > 0.5
+    demands = task_x[:, 16].round().clamp_min(1).to(dtype=torch.int64)
+    shortage: dict[str, int] = {}
+    for skill_id in range(layout.num_skill_types):
+        task_demand = int(demands[physical & skill_present[:, skill_id]].max().item()) if bool(
+            (physical & skill_present[:, skill_id]).any()
+        ) else 0
+        available = int(worker_skills[:, skill_id].sum().item())
+        shortage[str(skill_id)] = available - task_demand
+    return {
+        "path": str(data_path.resolve()),
+        "sha256": _sha256(data_path),
+        "num_tasks": int(task_x.size(0)),
+        "num_workers": int(worker_x.size(0)),
+        "num_skill_types": int(layout.num_skill_types),
+        "physical_task_count": int(physical.sum().item()),
+        "tasks_without_required_skill": int((physical & ~skill_present.any(dim=1)).sum().item()),
+        "workers_by_skill": [int(value) for value in worker_skills.sum(dim=0).tolist()],
+        "worker_shortage_against_max_task_demand": shortage,
+    }
+
