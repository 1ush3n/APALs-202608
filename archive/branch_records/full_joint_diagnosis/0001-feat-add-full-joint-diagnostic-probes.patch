+def _schedule_metrics(
+    env: AirLineEnv_Graph,
+    total_reward: float,
+    *,
+    failure_reason: str = "",
+    deadlock_count: int = 0,
+) -> dict[str, Any]:
+    schedule = list(env.assigned_tasks)
+    complete = len(schedule) == env.num_tasks
+    legal = False
+    violations: list[str] = []
+    if complete:
+        legality = env.validate_assignments(schedule)
+        legal = bool(legality.is_legal)
+        if not legal:
+            violations = [str(item) for item in legality.violations]
+    if complete and legal:
+        makespan = float(np.max(env.station_wall_clock))
+        balance_std = float(np.std(env.station_loads))
+        reward = float(total_reward)
+    else:
+        makespan = float(env.ideal_makespan * 3.0)
+        balance_std = float(env.ideal_station_load * 3.0)
+        penalty = float(configs.deadlock_penalty_constant * configs.r_coef_makespan * configs.reward_scale * 4)
+        reward = float(total_reward - penalty)
+
+    worker_busy = 0.0
+    station_busy = np.zeros(env.num_stations, dtype=float)
+    skill_busy = np.zeros(resolve_worker_feature_layout(configs).num_skill_types, dtype=float)
+    worker_tasks: dict[int, list[tuple[float, float]]] = {}
+    layout = resolve_worker_feature_layout(configs)
+    worker_skills = env.base_worker_x[:, layout.skill_slice].detach().cpu().numpy() > 0.5
+    for _task_id, station_id, team, start, end in schedule:
+        duration = max(0.0, float(end) - float(start))
+        worker_busy += duration * len(team)
+        if station_id >= 0:
+            station_busy[station_id] += duration
+        for worker_id in team:
+            worker_tasks.setdefault(int(worker_id), []).append((float(start), float(end)))
+            if 0 <= int(worker_id) < worker_skills.shape[0]:
+                skill_busy += duration * worker_skills[int(worker_id)].astype(float)
+    waits: list[float] = []
+    for intervals in worker_tasks.values():
+        previous_end = 0.0
+        for start, end in sorted(intervals):
+            waits.append(max(0.0, start - previous_end))
+            previous_end = max(previous_end, end)
+    worker_util = worker_busy / (env.num_workers * makespan) if makespan > 0 else 0.0
+    station_util = (
+        float(station_busy.sum())
+        / (env.num_stations * int(getattr(configs, "max_slots_per_station", 3)) * makespan)
+        if makespan > 0
+        else 0.0
+    )
+    skill_counts = worker_skills.sum(axis=0).astype(float)
+    skill_util = np.divide(
+        skill_busy,
+        skill_counts * max(makespan, 1.0e-12),
+        out=np.zeros_like(skill_busy),
+        where=skill_counts > 0,
+    )
+    return {
+        "complete": bool(complete),
+        "legal": bool(legal),
+        "failure_reason": str(failure_reason),
+        "violations": violations,
+        "scheduled_tasks": len(schedule),
+        "num_tasks": int(env.num_tasks),
+        "completion_rate": float(len(schedule) / max(1, env.num_tasks)),
+        "deadlock_count": int(deadlock_count),
+        "makespan": makespan,
+        "balance_std": balance_std,
+        "reward": reward,
+        "worker_utilization": float(worker_util),
+        "station_utilization": float(station_util),
+        "avg_worker_wait_h": float(np.mean(waits)) if waits else 0.0,
+        "skill_utilization": [float(value) for value in skill_util.tolist()],
+    }
+
+
+def _canonicalize_assigned(row: Any) -> tuple[int, int, tuple[int, ...]]:
+    """从环境的 task/station/team/start/end 记录中提取动作前三项。"""
+    return canonicalize_action((row[0], row[1], row[2]))
+
+
+def _run_learned_episode(
+    agent: PPOAgent,
+    env: AirLineEnv_Graph,
+    scenario: Mapping[str, Any],
+    seed: int,
+) -> tuple[dict[str, Any], list[dict[str, Any]]]:
+    state = env.reset(
+        randomize_duration=bool(scenario["rand_dur"]),
+        randomize_workers=bool(scenario["rand_w"]),
+        seed=int(seed),
+    )
+    events: list[dict[str, Any]] = []
+    total_reward = 0.0
+    deadlocks = 0
+    failure_reason = ""
+    agent.policy.eval()
+    for step in range(max(1, env.num_tasks * 3)):
+        task_mask, station_mask, worker_mask = env.get_masks()
+        if bool(task_mask.all()):
+            if env.try_wait_for_resources():
+                events.append({"type": "wait"})
+                state = refresh_env_observation(env)
+                continue
+            deadlocks += 1
+            failure_reason = "learned_deadlock"
+            break
+        result = agent.select_action(
+            state.to(agent.device),
+            mask_task=task_mask.to(agent.device),
+            mask_station_matrix=station_mask.to(agent.device),
+            mask_worker=worker_mask.to(agent.device),
+            deterministic=True,
+            temperature=0.0,
+            is_eval=True,
+        )
+        if result[0] is None:
+            failure_reason = "learned_no_action"
+            break
+        action = canonicalize_action(result[0])
+        before_len = len(env.assigned_tasks)
+        state, reward, done, info = env.step(action)
+        total_reward += float(reward)
+        new_rows = env.assigned_tasks[before_len:]
+        actuals = [_canonicalize_assigned(row) for row in new_rows]
+        event = {
+            "type": "action",
+            "step": int(step),
+            "action": list(action[:2]) + [list(action[2])],
+            "executed_actions": [list(item[:2]) + [list(item[2])] for item in actuals],
+            "action_match": any(compare_actions(action, actual) for actual in actuals),
+        }
+        events.append(event)
+        if info.get("invalid_action", False) or info.get("error"):
+            failure_reason = "learned_invalid_action"
+            break
+        if done:
+            break
+    if not failure_reason and len(env.assigned_tasks) != env.num_tasks:
+        failure_reason = "learned_step_limit"
+    metrics = _schedule_metrics(
+        env,
+        total_reward,
+        failure_reason=failure_reason,
+        deadlock_count=deadlocks,
+    )
+    metrics["action_mismatch_count"] = sum(
+        1 for event in events if event.get("type") == "action" and not event["action_match"]
+    )
+    return metrics, events
+
+
+def _run_forced_eft_episode(
+    env: AirLineEnv_Graph,
+    scenario: Mapping[str, Any],
+    seed: int,
+    learned_events: list[Mapping[str, Any]],
+) -> tuple[dict[str, Any], list[dict[str, Any]]]:
+    state = env.reset(
+        randomize_duration=bool(scenario["rand_dur"]),
+        randomize_workers=bool(scenario["rand_w"]),
+        seed=int(seed),
+    )
+    completer = EarliestFinishActionCompleter(configs)
+    total_reward = 0.0
+    deadlocks = 0
+    failure_reason = ""
+    events: list[dict[str, Any]] = []
+    for event in learned_events:
+        if event["type"] == "wait":
+            task_mask, _, _ = env.get_masks()
+            if bool(task_mask.all()):
+                if not env.try_wait_for_resources():
+                    deadlocks += 1
+                    failure_reason = "eft_deadlock"
+                    break
+                state = refresh_env_observation(env)
+                events.append({"type": "wait", "reason": "replayed_no_legal_task"})
+            continue
+
+        task_id, station_id, team = event["action"]
+        action = None
+        for _ in range(max(1, env.num_tasks * 3)):
+            task_mask, station_mask, worker_mask = env.get_masks()
+            if task_id < 0 or task_id >= env.num_tasks:
+                failure_reason = "fixed_task_pair_out_of_range"
+                break
+            if bool(task_mask[task_id]):
+                if not env.try_wait_for_resources():
+                    deadlocks += 1
+                    failure_reason = "eft_deadlock_before_fixed_task"
+                    break
+                state = refresh_env_observation(env)
+                events.append({"type": "wait", "reason": "fixed_task_not_ready"})
+                continue
+            is_virtual = not bool(
+                (state["task"].x[task_id, 5 : 5 + int(configs.num_skill_types)] > 0.5).any()
+            )
+            if is_virtual:
+                if station_id != -1 or team:
+                    failure_reason = "fixed_virtual_action_invalid"
+                    break
+                action = (int(task_id), -1, [])
+                break
+            if station_id < 0 or station_id >= env.num_stations or bool(station_mask[task_id, station_id]):
+                if not env.try_wait_for_resources():
+                    deadlocks += 1
+                    failure_reason = "eft_deadlock_before_fixed_station"
+                    break
+                state = refresh_env_observation(env)
+                events.append({"type": "wait", "reason": "fixed_station_not_ready"})
+                continue
+            completed = completer.complete(
+                state,
+                task_id=int(task_id),
+                station_mask=station_mask[task_id],
+                worker_mask=worker_mask,
+                selected_station=int(station_id),
+            )
+            if completed is None or int(completed.station_id) != int(station_id):
+                if not env.try_wait_for_resources():
+                    deadlocks += 1
+                    failure_reason = "eft_team_infeasible_for_fixed_pair"
+                    break
+                state = refresh_env_observation(env)
+                events.append({"type": "wait", "reason": "eft_team_not_ready"})
+                continue
+            action = (int(task_id), int(station_id), list(completed.team))
+            break
+        if action is None:
+            if not failure_reason:
+                failure_reason = "fixed_pair_wait_limit"
+            break
+        before_len = len(env.assigned_tasks)
+        state, reward, done, info = env.step(action)
+        total_reward += float(reward)
+        new_rows = env.assigned_tasks[before_len:]
+        actuals = [_canonicalize_assigned(row) for row in new_rows]
+        events.append(
+            {
+                "type": "action",
+                "action": list(canonicalize_action(action)[:2]) + [list(canonicalize_action(action)[2])],
+                "executed_actions": [list(item[:2]) + [list(item[2])] for item in actuals],
+                "action_match": any(compare_actions(action, actual) for actual in actuals),
+            }
+        )
+        if info.get("invalid_action", False) or info.get("error"):
+            failure_reason = "eft_invalid_action"
+            break
+        if done:
+            break
+    if not failure_reason and len(env.assigned_tasks) != env.num_tasks:
+        failure_reason = "fixed_trace_exhausted"
+    metrics = _schedule_metrics(
+        env,
+        total_reward,
+        failure_reason=failure_reason,
+        deadlock_count=deadlocks,
+    )
+    metrics["action_mismatch_count"] = sum(
+        1 for event in events if event.get("type") == "action" and not event["action_match"]
+    )
+    return metrics, events
+
+
+def _pair_rates(
+    learned_events: list[Mapping[str, Any]], eft_events: list[Mapping[str, Any]]
+) -> tuple[float, float]:
+    learned_actions = [item for item in learned_events if item["type"] == "action"]
+    eft_actions = [item for item in eft_events if item["type"] == "action"]
+    count = min(len(learned_actions), len(eft_actions))
+    if count == 0:
+        return float("nan"), float("nan")
+    sequence_diffs = 0
+    set_diffs = 0
+    for learned, eft in zip(learned_actions[:count], eft_actions[:count]):
+        learned_action = canonicalize_action(learned["action"])
+        eft_action = canonicalize_action(eft["action"])
+        sequence_diffs += learned_action[2] != eft_action[2]
+        set_diffs += set(learned_action[2]) != set(eft_action[2])
+    return sequence_diffs / count, set_diffs / count
+
+
+def run_worker_ab(
+    checkpoint_path: Path,
+    data_paths: Iterable[Path],
+    scenarios: Iterable[Mapping[str, Any]],
+    seeds: Iterable[int],
+    output_dir: Path,
+) -> dict[str, Any]:
+    _, agent, _ = _load_agent(checkpoint_path)
+    rows: list[dict[str, Any]] = []
+    traces: list[dict[str, Any]] = []
+    backups = _set_scenario(configs, {"dyn_ev": False})
+    try:
+        for data_path in data_paths:
+            for scenario in scenarios:
+                for seed in seeds:
+                    apply_initial_worker_mapping(
+                        configs, data_path, explicit_fields=set()
+                    )
+                    set_seed(int(seed))
+                    learned_env = AirLineEnv_Graph(data_path_or_dir=str(data_path), seed=int(seed))
+                    learned_metrics, learned_events = _run_learned_episode(
+                        agent, learned_env, scenario, int(seed)
+                    )
+                    set_seed(int(seed))
+                    eft_env = AirLineEnv_Graph(data_path_or_dir=str(data_path), seed=int(seed))
+                    eft_metrics, eft_events = _run_forced_eft_episode(
+                        eft_env, scenario, int(seed), learned_events
+                    )
+                    sequence_rate, set_rate = _pair_rates(learned_events, eft_events)
+                    rows.append(
+                        {
+                            "data": str(data_path),
+                            "scenario": scenario["name"],
+                            "seed": int(seed),
+                            "learned": learned_metrics,
+                            "eft_fixed_pair": eft_metrics,
+                            "makespan_improvement_rate": (
+                                (learned_metrics["makespan"] - eft_metrics["makespan"])
+                                / learned_metrics["makespan"]
+                                if learned_metrics["makespan"] > 0
+                                else float("nan")
+                            ),
+                            "team_sequence_difference_rate": sequence_rate,
+                            "team_set_difference_rate": set_rate,
+                        }
+                    )
+                    traces.append(
+                        {
+                            "data": str(data_path),
+                            "scenario": scenario["name"],
+                            "seed": int(seed),
+                            "learned_events": learned_events,
+                            "eft_events": eft_events,
+                        }
+                    )
+    finally:
+        _restore_values(configs, backups)
+    report = {
+        "protocol": "same_checkpoint_same_task_station_fixed_pair_deterministic",
+        "checkpoint": str(checkpoint_path.resolve()),
+        "rows": rows,
+    }
+    _write_json(output_dir / "worker_ab.json", report)
+    _write_json(output_dir / "worker_ab_traces.json", traces)
+    return report
+
+
+def run_identity(
+    checkpoint_path: Path,
+    data_paths: Iterable[Path],
+    scenarios: Iterable[Mapping[str, Any]],
+    seeds: Iterable[int],
+    output_dir: Path,
+    max_actions: int,
+) -> dict[str, Any]:
+    _, agent, _ = _load_agent(checkpoint_path)
+    rows: list[dict[str, Any]] = []
+    failures: list[dict[str, Any]] = []
+    backups = _set_scenario(configs, {"dyn_ev": False})
+    try:
+        for data_path in data_paths:
+            for scenario in scenarios:
+                for seed in seeds:
+                    apply_initial_worker_mapping(
+                        configs, data_path, explicit_fields=set()
+                    )
+                    set_seed(int(seed))
+                    env = AirLineEnv_Graph(data_path_or_dir=str(data_path), seed=int(seed))
+                    state = env.reset(
+                        randomize_duration=bool(scenario["rand_dur"]),
+                        randomize_workers=bool(scenario["rand_w"]),
+                        seed=int(seed),
+                    )
+                    action_count = 0
+                    while action_count < max_actions:
+                        task_mask, station_mask, worker_mask = env.get_masks()
+                        if bool(task_mask.all()):
+                            if env.try_wait_for_resources():
+                                state = refresh_env_observation(env)
+                                continue
+                            failures.append({"data": str(data_path), "scenario": scenario["name"], "seed": int(seed), "reason": "deadlock"})
+                            break
+                        trace: dict[str, Any] = {}
+                        result = agent.select_action(
+                            state.to(agent.device),
+                            mask_task=task_mask.to(agent.device),
+                            mask_station_matrix=station_mask.to(agent.device),
+                            mask_worker=worker_mask.to(agent.device),
+                            deterministic=False,
+                            temperature=1.0,
+                            is_eval=True,
+                            diagnostic_trace=trace,
+                        )
+                        if result[0] is None:
+                            failures.append({"data": str(data_path), "scenario": scenario["name"], "seed": int(seed), "reason": "no_action"})
+                            break
+                        action = canonicalize_action(result[0])
+                        replay = agent.diagnose_action_logprobs(
+                            state.to(agent.device),
+                            action,
+                            mask_task=task_mask.to(agent.device),
+                            mask_station_matrix=station_mask.to(agent.device),
+                            mask_worker=worker_mask.to(agent.device),
+                            temperature=1.0,
+                            is_eval=True,
+                        )
+                        old_workers = [float(value) for value in trace.get("worker_logprobs", [])]
+                        new_workers = [float(value) for value in replay.get("worker_logprobs", [])]
+                        worker_error = max(
+                            [abs(a - b) for a, b in zip(old_workers, new_workers)]
+                            + [abs(len(old_workers) - len(new_workers))],
+                        )
+                        old_total = float(trace.get("total_logprob", result[1]))
+                        actual_task_error = abs(float(trace.get("task_logprob", 0.0)) - replay["task"])
+                        actual_station_error = abs(float(trace.get("station_logprob", 0.0)) - replay["station"])
+                        total_error = abs(old_total - replay["total"])
+                        before_len = len(env.assigned_tasks)
+                        state, _reward, done, info = env.step(action)
+                        actuals = [
+                            _canonicalize_assigned(row)
+                            for row in env.assigned_tasks[before_len:]
+                        ]
+                        row = {
+                            "data": str(data_path),
+                            "scenario": scenario["name"],
+                            "seed": int(seed),
+                            "step": int(action_count),
+                            "team_size": int(len(action[2])),
+                            "task": actual_task_error,
+                            "station": actual_station_error,
+                            "worker": worker_error,
+                            "total": total_error,
+                            "action_mismatch": int(
+                                not any(compare_actions(action, actual) for actual in actuals)
+                            ),
+                            "info_invalid_action": bool(info.get("invalid_action", False)),
+                            "worker_entropy_sum": float(sum(replay.get("worker_entropy", []))),
+                            "worker_entropy_mean": float(
+                                np.mean(replay.get("worker_entropy", []))
+                                if replay.get("worker_entropy")
+                                else 0.0
+                            ),
+                            "worker_max_probability_mean": float(
+                                np.mean(replay.get("worker_max_probability", []))
+                                if replay.get("worker_max_probability")
+                                else 0.0
+                            ),
+                            "legal_worker_count_mean": float(
+                                np.mean(replay.get("legal_worker_count", []))
+                                if replay.get("legal_worker_count")
+                                else 0.0
+                            ),
+                        }
+                        rows.append(row)
+                        action_count += 1
+                        if done:
+                            break
+                    else:
+                        failures.append({"data": str(data_path), "scenario": scenario["name"], "seed": int(seed), "reason": "action_limit"})
+    finally:
+        _restore_values(configs, backups)
+    report = {
+        "protocol": "random_rollout_then_no_update_single_state_replay",
+        "checkpoint": str(checkpoint_path.resolve()),
+        "logprob": logprob_error_summary(rows),
+        "team_size_summary": summarize_by_team_size(
+            [row for row in rows if int(row["team_size"]) > 0],
+            value_keys=(
+                "worker_entropy_sum",
+                "worker_entropy_mean",
+                "worker_max_probability_mean",
+                "legal_worker_count_mean",
+                "worker",
+                "total",
+            ),
+        ),
+        "action_mismatch_count": sum(int(row["action_mismatch"]) for row in rows),
+        "rows": rows,
+        "failures": failures,
+    }
+    _write_json(output_dir / "identity.json", report)
+    return report
+
+
+def run_tflogs(
+    train_roots: Iterable[Path], async_roots: Iterable[Path], output_dir: Path
+) -> dict[str, Any]:
+    report = {
+        "training": summarize_tensorboard_events(train_roots),
+        "async_eval": summarize_tensorboard_events(async_roots),
+    }
+    _write_json(output_dir / "tflogs_all_scalars.json", report)
+    return report
+
+
+def _write_worker_csv(path: Path, rows: list[Mapping[str, Any]]) -> None:
+    fields = [
+        "data",
+        "scenario",
+        "seed",
+        "learned_makespan",
+        "eft_makespan",
+        "makespan_improvement_rate",
+        "learned_reward",
+        "eft_reward",
+        "learned_completion_rate",
+        "eft_completion_rate",
+        "learned_legal",
+        "eft_legal",
+        "team_sequence_difference_rate",
+        "team_set_difference_rate",
+    ]
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with path.open("w", newline="", encoding="utf-8-sig") as handle:
+        writer = csv.DictWriter(handle, fieldnames=fields)
+        writer.writeheader()
+        for row in rows:
+            learned = row["learned"]
+            eft = row["eft_fixed_pair"]
+            writer.writerow(
+                {
+                    "data": row["data"],
+                    "scenario": row["scenario"],
+                    "seed": row["seed"],
+                    "learned_makespan": learned["makespan"],
+                    "eft_makespan": eft["makespan"],
+                    "makespan_improvement_rate": row["makespan_improvement_rate"],
+                    "learned_reward": learned["reward"],
+                    "eft_reward": eft["reward"],
+                    "learned_completion_rate": learned["completion_rate"],
+                    "eft_completion_rate": eft["completion_rate"],
+                    "learned_legal": learned["legal"],
+                    "eft_legal": eft["legal"],
+                    "team_sequence_difference_rate": row["team_sequence_difference_rate"],
+                    "team_set_difference_rate": row["team_set_difference_rate"],
+                }
+            )
+
+
+def _parse_args(argv: list[str] | None = None) -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description="APAL Full 初始调度诊断")
+    parser.add_argument("--mode", choices=("protocol", "worker-ab", "identity", "tflogs"), required=True)
+    parser.add_argument("--checkpoint", type=Path, default=DEFAULT_CHECKPOINT)
+    parser.add_argument("--data", type=Path, action="append", default=None)
+    parser.add_argument("--scenario", action="append", default=None)
+    parser.add_argument("--seed", type=int, action="append", default=None)
+    parser.add_argument("--resolved-config", type=Path, default=None)
+    parser.add_argument("--output-dir", type=Path, default=None)
+    parser.add_argument("--train-root", type=Path, action="append", default=None)
+    parser.add_argument("--async-root", type=Path, action="append", default=None)
+    parser.add_argument("--max-actions", type=int, default=1000)
+    return parser.parse_args(argv)
+
+
+def main(argv: list[str] | None = None) -> int:
+    args = _parse_args(argv)
+    output_dir = args.output_dir or (
+        PROJECT_ROOT
+        / "diagnostics"
+        / "full_joint"
+        / f"{args.mode.replace('-', '_')}_{datetime.now().strftime('%Y%m%d_%H%M%S')}"
+    )
+    output_dir.mkdir(parents=True, exist_ok=True)
+    data_paths = [_resolve_path(path) for path in (args.data or [Path(item) for item in DEFAULT_DATA])]
+    seeds = args.seed or [42]
+    scenarios = _scenario_specs(args.scenario)
+    if args.mode == "protocol":
+        report = run_protocol_audit(
+            _resolve_path(args.checkpoint),
+            data_paths,
+            None if args.resolved_config is None else _resolve_path(args.resolved_config),
+        )
+        _write_json(output_dir / "protocol.json", report)
+    elif args.mode == "worker-ab":
+        report = run_worker_ab(
+            _resolve_path(args.checkpoint), data_paths, scenarios, seeds, output_dir
+        )
+        _write_worker_csv(output_dir / "worker_ab.csv", report["rows"])
+    elif args.mode == "identity":
+        run_identity(
+            _resolve_path(args.checkpoint),
+            data_paths,
+            scenarios,
+            seeds,
+            output_dir,
+            max(1, int(args.max_actions)),
+        )
+    else:
+        train_roots = [_resolve_path(path) for path in (args.train_root or [])]
+        async_roots = [_resolve_path(path) for path in (args.async_root or [])]
+        if not train_roots and not async_roots:
+            raise ValueError("tflogs 模式至少需要 --train-root 或 --async-root")
+        run_tflogs(train_roots, async_roots, output_dir)
+    print(f"[FullJointDiagnostics] output={output_dir.resolve()}", flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
