+from __future__ import annotations
+
+import math
+from pathlib import Path
+from typing import Any, Iterable, Mapping, Sequence
+
+
+def canonicalize_action(
+    action: Sequence[Any], *, virtual_task: bool = False
+) -> tuple[int, int, tuple[int, ...]]:
+    """规范化动作，但保留自回归团队的选择顺序。"""
+    if len(action) != 3:
+        raise ValueError(f"动作必须是(task, station, team)，收到 {action!r}")
+    task_id = int(action[0])
+    if virtual_task:
+        return task_id, -1, ()
+    station_id = int(action[1])
+    team = tuple(int(worker_id) for worker_id in action[2])
+    if len(set(team)) != len(team):
+        raise ValueError(f"团队不能包含重复工人: {team!r}")
+    return task_id, station_id, team
+
+
+def compare_actions(expected: Sequence[Any], actual: Sequence[Any]) -> bool:
+    """严格比较 task、station 和有序 worker sequence。"""
+    return canonicalize_action(expected) == canonicalize_action(actual)
+
+
+def _finite_values(values: Iterable[Any]) -> list[float]:
+    finite: list[float] = []
+    for value in values:
+        try:
+            number = float(value)
+        except (TypeError, ValueError):
+            continue
+        if math.isfinite(number):
+            finite.append(number)
+    return finite
+
+
+def summarize_numeric(values: Sequence[Any], *, window: int = 10) -> dict[str, Any]:
+    """统计数值序列，非有限值计数不参与均值、范围和趋势。"""
+    raw = list(values)
+    finite = _finite_values(raw)
+    nan_count = 0
+    inf_count = 0
+    for value in raw:
+        try:
+            number = float(value)
+        except (TypeError, ValueError):
+            nan_count += 1
+            continue
+        if math.isnan(number):
+            nan_count += 1
+        elif math.isinf(number):
+            inf_count += 1
+    if not finite:
+        return {
+            "latest": float("nan"),
+            "mean": float("nan"),
+            "window_mean": float("nan"),
+            "minimum": float("nan"),
+            "maximum": float("nan"),
+            "nan_count": nan_count,
+            "inf_count": inf_count,
+            "trend": "no_finite_value",
+        }
+    recent = finite[-max(1, int(window)) :]
+    trend = "flat"
+    if len(recent) >= 2:
+        rising = all(a <= b for a, b in zip(recent, recent[1:])) and any(
+            a < b for a, b in zip(recent, recent[1:])
+        )
+        falling = all(a >= b for a, b in zip(recent, recent[1:])) and any(
+            a > b for a, b in zip(recent, recent[1:])
+        )
+        if rising:
+            trend = "rising"
+        elif falling:
+            trend = "falling"
+        elif max(recent) - min(recent) > 1.0e-12:
+            trend = "mixed"
+    return {
+        "latest": finite[-1],
+        "mean": sum(finite) / len(finite),
+        "window_mean": sum(recent) / len(recent),
+        "minimum": min(finite),
+        "maximum": max(finite),
+        "nan_count": nan_count,
+        "inf_count": inf_count,
+        "trend": trend,
+    }
+
+
+def team_size_bucket(team_size: int) -> str:
+    """将团队人数映射到 clipping/entropy 诊断分组。"""
+    size = int(team_size)
+    if size < 1:
+        raise ValueError(f"团队人数必须为正数: {size}")
+    return str(size) if size <= 4 else "5+"
+
+
+def summarize_by_team_size(
+    records: Iterable[Mapping[str, Any]],
+    *,
+    value_keys: Sequence[str],
+) -> dict[str, dict[str, Any]]:
+    """按团队人数汇总诊断记录，保留样本数和每个字段的完整统计。"""
+    grouped: dict[str, list[Mapping[str, Any]]] = {}
+    for record in records:
+        bucket = team_size_bucket(int(record["team_size"]))
+        grouped.setdefault(bucket, []).append(record)
+    output: dict[str, dict[str, Any]] = {}
+    for bucket, items in grouped.items():
+        output[bucket] = {
+            "count": len(items),
+            **{
+                key: summarize_numeric([item.get(key) for item in items])
+                for key in value_keys
+            },
+        }
+    return output
+
+
+def logprob_error_summary(rows: Iterable[Mapping[str, Any]]) -> dict[str, Any]:
+    """汇总 task/station/worker/total 的 rollout-replay 绝对误差。"""
+    records = list(rows)
+    result: dict[str, Any] = {}
+    for key in ("task", "station", "worker", "total"):
+        values = [abs(float(row.get(key, float("nan")))) for row in records]
+        finite = _finite_values(values)
+        result[f"max_{key}_error"] = max(finite) if finite else float("nan")
+    result["sample_count"] = len(records)
+    total = result["max_total_error"]
+    worker = result["max_worker_error"]
+    result["passed_fp32"] = bool(
+        math.isfinite(total) and math.isfinite(worker) and max(total, worker) <= 1.0e-5
+    )
+    result["passed_bf16"] = bool(
+        math.isfinite(total) and math.isfinite(worker) and max(total, worker) <= 1.0e-3
+    )
+    return result
+
+
+def validate_protocol_invariants(
+    actual: Mapping[str, Any], expected: Mapping[str, Any]
+) -> list[str]:
+    """逐字段检查实验口径；缺失字段也必须显式报告。"""
+    errors: list[str] = []
+    for key, expected_value in expected.items():
+        actual_value = actual.get(key, "<missing>")
+        if actual_value != expected_value:
+            errors.append(
+                f"{key}: actual={actual_value!r}, expected={expected_value!r}"
+            )
+    return errors
+
+
+def discover_event_files(roots: Iterable[str | Path]) -> list[Path]:
+    """递归发现 TensorBoard event 文件并去重。"""
+    files: set[Path] = set()
+    for raw_root in roots:
+        root = Path(raw_root)
+        if root.is_file() and "tfevents" in root.name:
+            files.add(root.resolve())
+        elif root.is_dir():
+            files.update(
+                path.resolve()
+                for path in root.rglob("events.out.tfevents*")
+                if path.is_file()
+            )
+    return sorted(files)
+
+
+def summarize_tensorboard_events(
+    roots: Iterable[str | Path], *, window: int = 20
+) -> dict[str, Any]:
+    """读取所有 event 文件，按 scalar tag 汇总完整训练/验证曲线。"""
+    from tensorboard.backend.event_processing.event_accumulator import EventAccumulator
+
+    event_files = discover_event_files(roots)
+    tag_values: dict[str, list[tuple[int, float]]] = {}
+    tag_files: dict[str, set[str]] = {}
+    for event_file in event_files:
+        accumulator = EventAccumulator(
+            str(event_file), size_guidance={"scalars": 0}
+        )
+        accumulator.Reload()
+        for tag in accumulator.Tags().get("scalars", []):
+            tag_files.setdefault(tag, set()).add(str(event_file))
+            tag_values.setdefault(tag, []).extend(
+                (int(item.step), float(item.value))
+                for item in accumulator.Scalars(tag)
+            )
+    summaries: dict[str, Any] = {}
+    for tag, rows in sorted(tag_values.items()):
+        rows.sort(key=lambda item: item[0])
+        values = [value for _, value in rows]
+        summaries[tag] = {
+            "latest_step": rows[-1][0] if rows else None,
+            "event_count": len(rows),
+            "event_files": sorted(tag_files[tag]),
+            **summarize_numeric(values, window=window),
+        }
+    return {
+        "event_files": [str(path) for path in event_files],
+        "event_file_count": len(event_files),
+        "scalar_tag_count": len(summaries),
+        "scalars": summaries,
+    }
+
