+def _load_agent(checkpoint_path: Path) -> tuple[Any, PPOAgent, Path]:
+    checkpoint = load_checkpoint(checkpoint_path, map_location="cpu")
+    restore_checkpoint_saved_config(configs, checkpoint, set())
+    apply_checkpoint_model_spec(configs, checkpoint.model_spec, explicit_fields=set())
+    data_path = _resolve_path(configs.data_file_path)
+    apply_initial_worker_mapping(configs, data_path, explicit_fields=set())
+    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
+    model = HBGATPN(configs).to(device)
+    load_policy_weights(model, checkpoint, strict=True)
+    agent = PPOAgent(
+        model,
+        configs.lr,
+        configs.gamma,
+        configs.k_epochs,
+        configs.eps_clip,
+        device,
+        configs.batch_size,
+        config=configs,
+    )
+    agent.policy.eval()
+    return checkpoint, agent, data_path
