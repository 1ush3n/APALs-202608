--- /dev/null
+++ b/tests/test_action_truncation_evaluation.py
@@ -0,0 +1,55 @@
+from types import SimpleNamespace
+
+import pytest
+
+from evaluate_reschedule_model import (
+    get_action_truncation_forbidden_heads,
+    prepare_action_truncation_scope,
+)
+
+
+def test_action_truncation_forbidden_heads_match_scope():
+    assert get_action_truncation_forbidden_heads("operation") == (
+        "station_head",
+        "worker_head",
+    )
+    assert get_action_truncation_forbidden_heads("operation_station") == (
+        "worker_head",
+    )
+
+
+def test_action_truncation_scope_keeps_full_observation_and_uses_ea():
+    config = SimpleNamespace(
+        policy_action_scope="operation_station_worker",
+        policy_observation_scope="full",
+        action_completion_mode="earliest_finish",
+    )
+
+    prepare_action_truncation_scope(config, "operation")
+
+    assert config.policy_action_scope == "operation"
+    assert config.policy_observation_scope == "full"
+    assert config.action_completion_mode == "earliest_availability"
+
+
+@pytest.mark.parametrize("scope", ["operation_station_worker", "ctg", "apcf", "unknown"])
+def test_action_truncation_rejects_non_truncated_scope(scope):
+    config = SimpleNamespace(
+        policy_action_scope="operation_station_worker",
+        policy_observation_scope="full",
+        action_completion_mode="earliest_finish",
+    )
+
+    with pytest.raises(ValueError):
+        prepare_action_truncation_scope(config, scope)
+
+
+def test_action_truncation_rejects_non_full_source_model():
+    config = SimpleNamespace(
+        policy_action_scope="operation",
+        policy_observation_scope="task",
+        action_completion_mode="earliest_finish",
+    )
+
+    with pytest.raises(ValueError):
+        prepare_action_truncation_scope(config, "operation_station")
