 }
 
 
+_ACTION_TRUNCATION_FORBIDDEN_HEADS: dict[str, tuple[str, ...]] = {
+    "operation": ("station_head", "worker_head"),
+    "operation_station": ("worker_head",),
+}
+
+
+def get_action_truncation_forbidden_heads(action_scope: str) -> tuple[str, ...]:
+    """返回动作截取模式下不得调用的策略头。"""
+
+    try:
+        return _ACTION_TRUNCATION_FORBIDDEN_HEADS[action_scope]
+    except KeyError as exc:
+        allowed = ", ".join(sorted(_ACTION_TRUNCATION_FORBIDDEN_HEADS))
+        raise ValueError(f"动作截取只允许 {allowed}，实际为 {action_scope!r}") from exc
+
+
+def prepare_action_truncation_scope(config: Any, action_scope: str) -> None:
+    """在完整模型已构造后切换动作范围，并固定使用 EA 资源补全。"""
+
+    get_action_truncation_forbidden_heads(action_scope)
+    source_scope = str(getattr(config, "policy_action_scope", ""))
+    if source_scope != "operation_station_worker":
+        raise ValueError(
+            "动作截取的来源模型必须是 operation_station_worker，"
+            f"实际为 {source_scope!r}"
+        )
+    if str(getattr(config, "policy_observation_scope", "")) != "full":
+        raise ValueError("动作截取必须保留 full policy_observation_scope")
+    config.policy_action_scope = action_scope
+    config.action_completion_mode = "earliest_availability"
+
+
+def _install_action_truncation_guards(
+    model: torch.nn.Module,
+    action_scope: str,
+) -> list[Any]:
+    handles: list[Any] = []
+    for head_name in get_action_truncation_forbidden_heads(action_scope):
+        head = getattr(model, head_name, None)
+        if head is None:
+            raise AttributeError(f"完整模型缺少动作头: {head_name}")
+
+        def fail_if_called(_module: torch.nn.Module, _inputs: tuple[Any, ...], *, name: str = head_name) -> None:
+            raise RuntimeError(f"动作截取越界：不允许调用 {name}")
+
+        handles.append(head.register_forward_pre_hook(fail_if_called))
+    return handles
+
+
 def _as_id_list(value: Any) -> list[str] | None:
     if value is None:
         return None
